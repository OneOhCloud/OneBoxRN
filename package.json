{
  "name": "oneboxm",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./src/modules",
      "exclude": [
        "expo-dev-client",
        "expo-dev-launcher",
        "expo-dev-menu"
      ]
    }
  },
  "scripts": {
    "postinstall": "node scripts/patch-jsonc-parser.js && npm run sync-templates",
    "sync-templates": "node --experimental-strip-types scripts/sync-templates.ts",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "prepare": "husky"
  },
  "dependencies": {
    "@bugsnag/expo": "^55.0.0",
    "@expo-google-fonts/material-symbols": "^0.4.24",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~56.0.12",
    "expo-application": "~56.0.3",
    "expo-build-properties": "~56.0.19",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.15",
    "expo-crypto": "~56.0.4",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-linking": "~56.0.14",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.18",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "i18n-js": "^4.5.2",
    "jsonc-parser": "^2.3.1",
    "nativewind": "^5.0.0-preview.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css": "^3.0.4",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-paper": "^5.15.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.3.3",
    "@types/react": "~19.2.14",
    "eslint": "^9.0.1",
    "eslint-config-expo": "~56.0.4",
    "expo-dev-client": "~56.0.20",
    "husky": "^9.1.7",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
