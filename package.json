{
  "name": "oneboxm",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./src/modules",
      "exclude": [
        "expo-dev-client",
        "expo-dev-launcher",
        "expo-dev-menu"
      ]
    }
  },
  "scripts": {
    "postinstall": "node scripts/patch-jsonc-parser.js && npm run sync-templates",
    "sync-templates": "node --experimental-strip-types scripts/sync-templates.ts",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "prepare": "husky"
  },
  "dependencies": {
    "@bugsnag/expo": "^55.0.0",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.4",
    "expo-application": "~57.0.0",
    "expo-asset": "~57.0.0",
    "expo-build-properties": "~57.0.3",
    "expo-camera": "~57.0.1",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.2",
    "expo-crypto": "~57.0.0",
    "expo-device": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-localization": "~57.0.0",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "i18n-js": "^4.5.2",
    "jsonc-parser": "^2.3.1",
    "nativewind": "^5.0.0-preview.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-css": "^3.0.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.3.3",
    "@types/react": "~19.2.14",
    "eslint": "^9.0.1",
    "eslint-config-expo": "~57.0.0",
    "expo-dev-client": "~57.0.5",
    "husky": "^9.1.7",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "lightningcss": "1.30.1",
    "shell-quote": "1.8.4",
    "@xmldom/xmldom": "0.8.13",
    "lodash": "4.18.1",
    "picomatch@^2.0.0": "2.3.2",
    "undici": "6.27.0",
    "ws@^7.0.0": "7.5.11",
    "@babel/core": "7.29.7",
    "brace-expansion@^5.0.0": "5.0.7",
    "brace-expansion@^1.0.0": "1.1.13",
    "flatted": "3.4.2",
    "js-yaml@^4.0.0": "4.2.0",
    "xcode": {
      "uuid": "11.1.1"
    },
    "@bugsnag/expo": {
      "expo": "$expo",
      "expo-constants": "$expo-constants"
    }
  }
}
