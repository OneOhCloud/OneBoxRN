{
  "name": "oneboxm",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./src/modules",
      "exclude": [
        "expo-dev-client",
        "expo-dev-launcher",
        "expo-dev-menu"
      ]
    }
  },
  "scripts": {
    "postinstall": "node scripts/patch-jsonc-parser.js && npm run sync-templates",
    "sync-templates": "node --experimental-strip-types scripts/sync-templates.ts",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "prepare": "husky"
  },
  "dependencies": {
    "@bugsnag/expo": "^55.0.0",
    "@expo-google-fonts/material-symbols": "^0.4.24",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@react-navigation/elements": "^2.9.8",
    "@react-navigation/native": "^7.1.28",
    "expo": "~55.0.23",
    "expo-application": "~55.0.14",
    "expo-build-properties": "~55.0.13",
    "expo-camera": "~55.0.18",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.14",
    "expo-device": "~55.0.16",
    "expo-file-system": "~55.0.19",
    "expo-font": "~55.0.6",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.10",
    "expo-linking": "~55.0.15",
    "expo-localization": "~55.0.13",
    "expo-notifications": "~55.0.22",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.20",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.8",
    "expo-system-ui": "~55.0.17",
    "expo-web-browser": "~55.0.15",
    "i18n-js": "^4.5.2",
    "jsonc-parser": "^2.3.1",
    "nativewind": "^5.0.0-preview.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-css": "^3.0.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-paper": "^5.15.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.3.3",
    "@types/react": "~19.2.14",
    "eslint": "^9.0.1",
    "eslint-config-expo": "~55.0.0",
    "expo-dev-client": "~55.0.32",
    "husky": "^9.1.7",
    "typescript": "~5.9.3"
  },
  "private": true,
  "overrides": {
    "hermes-compiler": "250829098.0.4",
    "lightningcss": "1.30.1"
  }
