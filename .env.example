# Subscription Accelerator (optional)
# Base URL of the accelerator proxy. Leave blank to disable fallback loading.
accelerateUrl=

# Android Release Signing
# 密钥文件的绝对路径（或相对于 android/app/ 的路径）
ANDROID_KEYSTORE_PATH=/path/to/your/release.keystore
ANDROID_KEY_ALIAS=your-key-alias
ANDROID_STORE_PASSWORD=your-store-password
ANDROID_KEY_PASSWORD=your-key-password

# iOS Signing (xcodebuild 使用)
IOS_TEAM_ID=GN2W3N34TM
# app-store | ad-hoc | enterprise | development
IOS_EXPORT_METHOD=app-store

# S3 Sync (make sync-s3)
# 目标 S3 路径，如 s3://my-bucket/apks
S3_BUCKET=
# 可选：AWS CLI profile 和区域
# AWS_PROFILE=
# AWS_REGION=
